# --- Postgres ---
POSTGRES_CONTAINER_NAME=ct_postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ct_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Airflow webserver (common vars) ---
AIRFLOW_CONTAINER_NAME =airflow_webserver
AIRFLOW_PORT=8088
AIRFLOW__CORE__LOAD_EXAMPLES=0
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__WEBSERVER__WEB_SERVER_PORT = 8088
 
# =-- pgadmin ---
PGADMIN_PORT = 5050
PGADMIN_USER_NAME=admin@admin.com
PGADMIN_PASSWORD=admin

# -- airflow-init: --
# docker-compose run airflow-webserver airflow 
AIRFLOW_ADMIN_USER=admin 
AIRFLOW_ADMIN_FIRST=Admin 
AIRFLOW_ADMIN_LAST=User 
AIRFLOW_ADMIN_LAST=Admin 
AIRFLOW_ADMIN_EMAIL=admin@example.com 
AIRFLOW_ADMIN_PASSWORD=password admin
# docker-compose up -d


# Optional: Airflow DB URL if you prefer explicit connection string
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:change_me@postgres:5432/clinical_trials

